<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:drawable="@drawable/bg_progress_track" />
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="@color/secondary_container"
                    android:centerColor="@color/primary_container"
                    android:endColor="@color/primary_container" />
                <corners android:radius="999dp" />
            </shape>
        </clip>
    </item>
</layer-list>
